# CARACAL Fleet settings for compose.yml. Copy to .env; every value is optional.

# Hub image and version (https://github.com/TaurAnnun/caracal-fleet/pkgs/container/caracal-fleet)
CARACAL_HUB_IMAGE=ghcr.io/taurannun/caracal-fleet
CARACAL_HUB_VERSION=latest
# Port of the web UI. With the https profile, keep the hub local: CARACAL_HUB_PORT=127.0.0.1:8090
CARACAL_HUB_PORT=8090
# Domain for the https profile (docker compose --profile https up -d)
CARACAL_HUB_DOMAIN=fleet.example.com

# Default image of the CARACAL nodes; can also be changed in the UI (CARACAL updates)
CARACAL_NODE_IMAGE=ghcr.io/taurannun/caracal-node

# Password of the "admin" account, applied on every start. Leave empty to create the administrator in the UI.
CARACAL_HUB_ADMIN_PASSWORD=
# Enrollment token of the agents. Leave empty to generate one (shown in Settings).
CARACAL_HUB_ENROLL_TOKEN=
